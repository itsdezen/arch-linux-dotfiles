# Two input methods in one group, toggled with fcitx5's default trigger key
# (Ctrl+Space): keyboard-us (EN/US) and Unikey (Vietnamese, Telex — see
# conf/unikey.conf). Regenerated by fcitx5 on first run if missing; this
# stowed copy pins the group so a fresh install doesn't need manual setup
# via fcitx5-configtool.
[Groups/0]
Name=Default
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/0/Items/1]
Name=unikey
Layout=

[GroupOrder]
0=Default
