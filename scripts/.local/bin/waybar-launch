#!/usr/bin/env bash
set -euo pipefail

config_dir="$HOME/.config/waybar"

waybar &
pid=$!

while inotifywait -e modify,create,delete,move "$config_dir/config.jsonc" "$config_dir/style.css" >/dev/null 2>&1; do
  kill "$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  waybar &
  pid=$!
done
