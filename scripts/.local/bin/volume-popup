#!/usr/bin/env bash
set -euo pipefail

choice="$(printf '%s\n' "Volume Up" "Volume Down" "Toggle Mute" | fuzzel --dmenu --prompt "Volume> ")"

case "$choice" in
  "Volume Up")
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
    ;;
  "Volume Down")
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
    ;;
  "Toggle Mute")
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
    ;;
esac
