{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "margin-top": 8,
  "margin-left": 24,
  "margin-right": 24,

  "modules-left": ["custom/launcher", "hyprland/window", "custom/files", "custom/browser", "custom/terminal", "custom/clipboard"],
  "modules-center": [],
  "modules-right": ["hyprland/workspaces", "custom/fcitx5", "network", "pulseaudio", "battery", "custom/control-center", "clock#date", "clock#time"],

  "custom/launcher": {
    "format": "󰀵",
    "on-click": "fuzzel",
    "tooltip": false
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 50,
    "separate-outputs": true,
    "tooltip": false
  },

  "custom/files": {
    "format": "Files",
    "on-click": "spf",
    "tooltip": false
  },

  "custom/browser": {
    "format": "Browser",
    "on-click": "chromium",
    "tooltip": false
  },

  "custom/terminal": {
    "format": "Terminal",
    "on-click": "ghostty",
    "tooltip": false
  },

  "custom/clipboard": {
    "format": "Clipboard",
    "on-click": "clipboard-picker",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "format-icons": {
      "active": "󰝥",
      "default": "󰝦"
    }
  },

  "custom/fcitx5": {
    "exec": "fcitx5-status",
    "interval": 1,
    "return-type": "json",
    "format": "{text}",
    "on-click": "fcitx5-remote -t"
  },

  "network": {
    "format-wifi": "󰖩",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nm-connection-editor"
  },

  // battery module stays unconditional — Waybar auto-hides it when no
  // battery is present, so this config works on both desktop and laptop.
  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰂎", "󰁼", "󰁾", "󰂀", "󰁹"],
    "format-charging": "󰂄 {capacity}%",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "{icon}",
    "format-icons": {
      "muted": "󰝟",
      "default": ["󰕽", "󰕿", "󰕾"]
    },
    "on-click": "volume-popup",
    "scroll-step": 5
  },

  "custom/control-center": {
    "format": "󰙯",
    "on-click": "control-center",
    "tooltip": false
  },

  "clock#date": {
    "format": "{:%a %d %b}",
    "tooltip-format": "{:%Y-%m-%d}"
  },

  "clock#time": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%H:%M:%S}"
  }
}
